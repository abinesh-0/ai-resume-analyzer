# =============================================================
# AI Resume Analyzer — environment template
# -------------------------------------------------------------
# Copy this file to `.env` and fill in real values:
#     copy .env.example .env        (Windows)
#     cp .env.example .env          (Linux/macOS)
#
# NEVER commit the real .env — it is listed in .gitignore.
# Every key below is read by app.py via os.getenv().
# =============================================================


# --- Flask ---------------------------------------------------
# Session-signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_long_random_hex_string

# Set to "true" only during local development.
FLASK_DEBUG=false


# --- Supabase (PostgreSQL) -----------------------------------
# app.py stores all application data in Supabase PostgreSQL through
# psycopg. The publishable (anon) key is a hosted-API key only: it cannot
# run this application's SQL (row-level security rejects its writes), so
# the backend authenticates with the database password instead.
#
# EITHER paste the full connection string (recommended)
#     Supabase Dashboard -> Connect -> "Session pooler" (port 5432)
SUPABASE_DB_URL=postgresql://postgres.your_project_ref:your_database_password@your_pooler_host:5432/postgres
#
# OR leave SUPABASE_DB_URL empty and set only the database password -
# the Session Pooler host (aws-0-ap-northeast-1.pooler.supabase.com)
# and the postgres.<ref> user are then used automatically:
SUPABASE_DB_PASSWORD=your_database_password

# Optional. Only needed for the IPv4 pooler or a non-default target.
# When the host contains "pooler", the user defaults to postgres.<ref>.
#SUPABASE_DB_HOST=your_pooler_host
#SUPABASE_DB_PORT=5432
#SUPABASE_DB_USER=postgres.your_project_ref
#SUPABASE_DB_NAME=postgres

# Optional. Listed for reference — the Flask backend does not use these.
SUPABASE_URL=your_supabase_project_url
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key

# Server-only secret. Required to store uploaded resumes in the private
# "resumes" Storage bucket. Never expose it to the browser, never commit
# the real value, and never paste it into frontend code.
SUPABASE_SERVICE_ROLE_KEY=


# --- Storage paths -------------------------------------------
# Optional. Leave commented to use the defaults baked into app.py
# (./uploads, ./models/career_model.pkl, ./models/tfidf_vectorizer.pkl).
# Absolute paths are recommended in production.
#UPLOAD_FOLDER=./uploads
#MODEL_PATH=./models/career_model.pkl
#VECTORIZER_PATH=./models/tfidf_vectorizer.pkl


# --- SMTP / OTP email ----------------------------------------
# Registration is Gmail-only, so use a Gmail account with a
# 16-character App Password (NOT the account password).
# Google Account → Security → 2-Step Verification → App passwords
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_character_gmail_app_password
